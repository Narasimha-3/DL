    "def display_augmented_images(augmented_set, epoch):\n",
    "    \"\"\"Display augmented images in a grid using plt.imshow().\"\"\"\n",
    "    num_images = len(augmented_set)\n",
    "    cols = 3 \n",
    "    rows = (num_images // cols) + (num_images % cols > 0)  \n",
    "\n",
    "    fig, axes = plt.subplots(rows, cols, figsize=(10, 10))\n",
    "    print(f'Epoch {epoch+1} Augmented Images')\n",
    "\n",
    "    if rows == 1:\n",
    "        axes = np.array([axes])  \n",
    "\n",
    "    for idx, aug_img in enumerate(augmented_set):\n",
    "        ax = axes[idx // cols, idx % cols]  \n",
    "        ax.imshow(aug_img)\n",
    "        ax.axis('off')  \n",
    "        ax.set_title(f\"Image {idx+1}\")\n",
    "\n",
    "    if len(augmented_set) < rows * cols:\n",
    "        for ax in axes.flatten()[num_images:]:\n",
    "            ax.axis('off')\n",
    "\n",
    "    plt.tight_layout(rect=[0, 0, 1, 0.95]) \n",
    "    plt.show()\n",
    "\n",
    "# Example usage:\n",
    "image_paths = [r'C:\\Users\\DIVYANSH DESHMUKH\\Desktop\\Semester\\Seventh Semester\\Deep Learning\\DL\\flowers\\daisy\\5547758_eea9edfd54_n.jpg', r'C:\\Users\\DIVYANSH DESHMUKH\\Desktop\\Semester\\Seventh Semester\\Deep Learning\\DL\\flowers\\daisy\\5794835_d15905c7c8_n.jpg', r'flowers/rose/12240303_80d87f77a3_n.jpg']\n",
    "image_set = [Image.open(path) for path in image_paths]\n",
    "\n",
    "auto_augmenter = AutoAugment()\n",
    "\n",
    "augmented_set = []\n",
    "for img in image_set:\n",
    "    img_aug = auto_augmenter.rand_augment(img)\n",
    "    augmented_set.append(img_aug)\n",
    "\n",
    "display_augmented_images(augmented_set, epoch)\n"
   ]
